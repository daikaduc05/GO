# Security Configuration for UDP+TUN Agent
# Copy this file and modify as needed

# Encryption Settings
SECURITY_ENCRYPTION_ENABLED=true
SECURITY_ENCRYPTION_KEY=GENERATE_NEW_KEY_HERE
SECURITY_KEY_DERIVATION_SALT=udp-tun-agent-salt-2024

# Authentication Settings
SECURITY_AUTH_REQUIRED=true
SECURITY_TOKEN_EXPIRY=24h
SECURITY_MAX_LOGIN_ATTEMPTS=5
SECURITY_LOGIN_COOLDOWN=15m

# Input Validation
SECURITY_MAX_MESSAGE_SIZE=1024
SECURITY_ALLOWED_VIP_PATTERN=^10\.10\.\d{1,3}\.\d{1,3}$

# Rate Limiting
SECURITY_RATE_LIMIT_ENABLED=true
SECURITY_RATE_LIMIT_WINDOW=1m
SECURITY_RATE_LIMIT_MAX=60

# Security Recommendations:
# 1. Generate a strong encryption key: openssl rand -base64 32
# 2. Use unique salt for key derivation
# 3. Enable authentication for production
# 4. Set reasonable rate limits
# 5. Restrict VIP patterns to private ranges
# 6. Use TLS for signaling server connections
# 7. Regular security audits
# 8. Monitor failed login attempts
# 9. Implement proper logging
# 10. Keep dependencies updated
